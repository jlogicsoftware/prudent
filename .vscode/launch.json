{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "iPhone Simulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "emulatorId": "apple_ios_simulator" // > flutter emulators
    },
    {
      "name": "Android Emulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "emulatorId": "Pixel_9" // > flutter emulators
    },
    {
      "name": "Web (hot reloadable)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": ["-d", "chrome", "--web-experimental-hot-reload"]
    },
    {
      "name": "MacOS",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "macos"]
    },
    {
      "name": "Profile mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "Release mode",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
