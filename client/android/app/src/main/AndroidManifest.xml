<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="prudent"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The custom scheme Supabase confirmation and recovery links come back on
                 (ADR-013). Without this filter nothing on the device claims "prudent://", so the
                 link a user taps in their mail client does nothing at all: the server permits the
                 return address, Supabase mails it, app_links listens for it, and the OS never
                 delivers it. That failure is silent on every side, which is why it survived Phase
                 3 with the scheme configured everywhere except the one place the OS reads.

                 The value must match the build's ZEN_AUTH_REDIRECT_URI and the server's
                 AUTH_REDIRECT_URIS exactly — the server matches return addresses by exact string,
                 deliberately, so a near-miss is refused rather than approximated.

                 BROWSABLE is what lets a link opened from a mail client reach the app at all.
                 android:launchMode is singleTop above, so a link arriving while the app is already
                 running is delivered to the live activity instead of starting a second one — the
                 warm case, which the app handles separately from a cold start.

                 NO App Link (verified https) beside it, per ADR-013: that needs a real domain
                 serving assetlinks.json and a signing fingerprint, and Prudent has neither yet. The
                 known cost is stated there rather than implied here — a private-use scheme cannot
                 be owned, so any app may register "prudent" and receive a link carrying a live
                 token (RFC 8252 §8.6). Closing that is a domain away, not a code change. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="prudent" android:host="auth-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
