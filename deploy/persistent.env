# The persistent environment's deploy configuration (ADR-131). `task deploy:persistent` reads it;
# a variable already set in the shell wins, so a one-off override needs no edit.
#
# Public values and identifiers ONLY. A secret never goes here: those nine live in Secret Manager and
# reach the service by name (`--set-secrets`), and scripts/with_env_file.sh refuses a secret-looking
# key or an `sb_secret_` value. When the environment changes, this file changes in the same PR.
GCP_PROJECT=prudent-jlogicsoftware
GCP_REGION=europe-west1
SERVICE_NAME=prudent
ARTIFACT_REPO=prudent
RUNTIME_SERVICE_ACCOUNT=prudent-runtime@prudent-jlogicsoftware.iam.gserviceaccount.com
WEB_API_URL=https://prudent-947844939098.europe-west1.run.app
SUPABASE_URL=https://dfxccfplerfxlwonwyed.supabase.co
SUPABASE_KEY=sb_publishable_g2blKY856nTtyebpi6HYMA_xs9GAl9c
AUTH_REDIRECT_URIS=prudent://auth-callback
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=noreply@mail.jlogicsoftware.com
