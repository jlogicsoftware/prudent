      }
    },
    {
      "op": "account.balances",
      "outcome": "accepted",
      "input": {
        "account": "$z"
      }
    },
    {
      "op": "account.balances",
      "outcome": "accepted",
      "input": {
        "account": "$l"
      }
    },
    {
      "comment": "5.10: records remain and the flag is absent.",
      "op": "account.delete",
      "outcome": "refused",
      "input": {
        "account": "$z"
      }
    },
    {
      "comment": "5.53: false is the default.",
      "op": "account.delete",
      "outcome": "refused",
      "input": {
        "account": "$z",
        "deleteRecords": false
      }
    },
    {
      "comment": "5.12: the record, the correction and both legs of the transfer go with it, in one write.",
      "op": "account.delete",
      "outcome": "accepted",
      "input": {
        "account": "$z",
        "deleteRecords": true
      }
    },
    {
      "op": "account.get",
      "outcome": "refused",
      "input": {
        "account": "$z"
      }
    },
    {
      "op": "account.balances",
      "outcome": "accepted",
      "input": {
        "account": "$l"
      }
    },
    {
      "op": "account.list",
      "outcome": "accepted",
      "input": {}
    },
    {
      "comment": "An account with nothing in it needs no flag.",
      "op": "account.delete",
      "outcome": "accepted",
      "input": {
        "account": "$lato"
      }
    },
    {
      "op": "account.delete",
      "outcome": "refused",
      "input": {
        "account": "$lato"
      }
    },
    {
      "op": "account.get",
      "outcome": "refused",
