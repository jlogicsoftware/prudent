      "outcome": "refused",
      "input": {
        "category": "$food",
        "month": "2033-02",
        "currency": "DKK",
        "note": ""
      }
    },
    {
      "comment": "A later reset: discards February's -6000.",
      "op": "reset.create",
      "as": "apr",
      "outcome": "accepted",
      "input": {
        "category": "$food",
        "month": "2033-04",
        "currency": "DKK",
        "note": "spring"
      }
    },
