    {
      "comment": "Before any reset: 6000 - 6000 = 0 carried.",
      "op": "budget.summary",
      "outcome": "accepted",
      "input": {
        "month": "2033-04",
        "currency": "DKK"
      }
    },
    {
      "comment": "6.12: the reset records what it discards (January's 6000) and strips its note.",
      "op": "reset.create",
      "as": "feb",
      "outcome": "accepted",
      "input": {
        "category": "$food",
        "month": "2033-02",
        "currency": "dkk",
        "note": "  overspent on purpose  "
      }
    },
    {
      "comment": "From February nothing is carried in; the reset month is named.",
      "op": "budget.summary",
      "outcome": "accepted",
      "input": {
        "month": "2033-02",
        "currency": "DKK"
      }
    },
    {
      "comment": "Into April only February counts: -6000.",
      "op": "budget.summary",
      "outcome": "accepted",
      "input": {
        "month": "2033-04",
        "currency": "DKK"
      }
    },
    {
      "comment": "A reset after the month bounds nothing.",
      "op": "budget.summary",
      "outcome": "accepted",
      "input": {
        "month": "2033-01",
        "currency": "DKK"
      }
    },
    {
      "comment": "6.9: one live reset per slot (409).",
