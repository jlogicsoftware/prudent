{
  "name": "carry_over_reset",
  "description": "A reset bounds one category's carry-over in one currency from a month on: it records the carry-over it discards, one live reset per slot, a revocation once and never a delete; the latest live reset at or before the month is the boundary, and the summary names it. Currency DKK in 2033 is this scenario's own.",
  "rules": [
    "6.8",
    "6.9",
    "6.10",
    "6.11",
    "6.12"
  ],
  "steps": [
    {
      "op": "account.create",
      "as": "wallet",
      "outcome": "accepted",
      "input": {
        "name": "Wallet",
        "type": "ACCOUNT_TYPE_CHECKING",
        "balances": [
          {
            "currency": "DKK",
            "amountMinor": "1000000"
          }
        ],
        "isActive": true
      }
    },
    {
      "op": "category.create",
      "as": "food",
      "outcome": "accepted",
      "input": {
        "title": "Food",
        "iconKey": "food",
        "kind": "CATEGORY_KIND_EXPENSE"
      }
    },
    {
      "op": "budget.set",
      "outcome": "accepted",
      "input": {
        "category": "$food",
        "month": "2033-01",
        "currency": "DKK",
        "amountMinor": "10000"
      }
    },
    {
      "op": "record.create",
      "outcome": "accepted",
      "input": {
        "account": "$wallet",
        "category": "$food",
        "amountMinor": "-4000",
        "currency": "DKK",
        "date": "2033-01-05",
        "title": "Spend"
      }
    },
    {
      "op": "budget.set",
      "outcome": "accepted",
      "input": {
        "category": "$food",
        "month": "2033-02",
        "currency": "DKK",
        "amountMinor": "10000"
      }
    },
    {
      "op": "record.create",
      "outcome": "accepted",
      "input": {
        "account": "$wallet",
        "category": "$food",
        "amountMinor": "-16000",
        "currency": "DKK",
        "date": "2033-02-05",
        "title": "Spend"
      }
    },
    {
      "op": "budget.set",
      "outcome": "accepted",
      "input": {
        "category": "$food",
        "month": "2033-04",
        "currency": "DKK",
        "amountMinor": "10000"
      }
