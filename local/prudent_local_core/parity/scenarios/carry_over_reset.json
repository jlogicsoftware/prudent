      "outcome": "refused",
      "input": {
        "reset": "$apr"
      }
    },
    {
      "comment": "With April's reset revoked February's is the boundary again.",
      "op": "budget.summary",
      "outcome": "accepted",
      "input": {
        "month": "2033-06",
        "currency": "DKK"
      }
    },
